{
    "version": 5,
    "configurePresets": [
        {
            "name": "nix-base",
            "description": "Factored base settings for non-windows *nix based platforms.",
            "hidden": true,
            "installDir": "${sourceParentDir}/../../../prefix/${presetName}",
            "binaryDir": "${sourceParentDir}/../obj/${presetName}",
            "condition": {
                "type": "inList",
                "string": "${hostSystemName}",
                "list": [
                    "Darwin",
                    "Linux"
                ]
            },
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": {
                  "type": "PATH",
                  "value": "${sourceParentDir}/../../../prefix/${presetName}"
                },
                "CMAKE_INSTALL_PREFIX_PATH": {
                  "type": "PATH",
                  "value": "${sourceParentDir}/../../../prefix/${presetName}"
                },
                "CMAKE_LIBRARY_PATH": {
                  "type": "PATH",
                  "value": "${sourceParentDir}/../../../prefix/${presetName}/lib:$env{CMAKE_LIBRARY_PATH}"
                }
            }
        },
        {
            "name": "gnu-debug",
            "description": "Factored debug settings.",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS": "$env{CMAKE_C_FLAGS} -Og -g1 --coverage -fprofile-update=atomic",
                "CMAKE_CXX_FLAGS": "$env{CMAKE_CXX_FLAGS} -Og -g1 --coverage -fprofile-update=atomic"
            }
        },
        {
            "name": "gnu-release",
            "description": "Factored release settings.",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_FLAGS": "$env{CMAKE_C_FLAGS} -O3",
                "CMAKE_CXX_FLAGS": "$env{CMAKE_CXX_FLAGS} -O3"
            }
        },
        {
            "name": "static",
            "description": "Factored static linking settings.",
            "hidden": true,
            "cacheVariables": {
                "BUILD_SHARED_LIBS": {
                  "type": "BOOL",
                  "value": "OFF"
                }
            }
        },
        {
            "name": "shared",
            "description": "Factored shared/dynamic linking settings.",
            "hidden": true,
            "cacheVariables": {
                "BUILD_SHARED_LIBS": {
                  "type": "BOOL",
                  "value": "ON"
                }
            }
        },
        {
            "name": "nix-gnu-debug-static",
            "displayName": "*nix/GNU/Debug/Static",
            "description": "Debug build with static linking.",
            "hidden": false,
            "inherits": [
                "static",
                "gnu-debug",
                "nix-base"
            ]
        },
        {
            "name": "nix-gnu-debug-shared",
            "displayName": "*nix/GNU/Debug/Shared",
            "description": "Debug build with shared linking.",
            "hidden": false,
            "inherits": [
                "shared",
                "gnu-debug",
                "nix-base"
            ]
        },
        {
            "name": "nix-gnu-release-static",
            "displayName": "*nix/GNU/Release/Static",
            "description": "Release build with static linking and standard optimizations.",
            "hidden": false,
            "inherits": [
                "static",
                "gnu-release",
                "nix-base"
            ]
        },
        {
            "name": "nix-gnu-release-shared",
            "displayName": "*nix/GNU/Release/Shared",
            "description": "Release build with shared linking and standard optimizations.",
            "hidden": false,
            "inherits": [
                "shared",
                "gnu-release",
                "nix-base"
            ]
        },
        {
            "name": "win-base",
            "description": "Factored base settings for windows platforms (msvc developer environment).",
            "hidden": true,
            "generator": "Ninja",
            "installDir": "${sourceParentDir}/../../../prefix/${presetName}",
            "binaryDir": "${sourceParentDir}/../obj/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": {
                  "type": "PATH",
                  "value": "${sourceParentDir}/../../../prefix/${presetName}"
                },
                "CMAKE_INSTALL_PREFIX_PATH": {
                  "type": "PATH",
                  "value": "${sourceParentDir}/../../../prefix/${presetName}"
                },
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
            }
        },
        {
            "name": "msvc",
            "description": "Factored msvc compiler settings.",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            }
        },
        {
            "name": "clangcl",
            "description": "Factored clang-cl compiler settings.",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl"
            }
        },
        {
            "name": "win-debug",
            "description": "Factored windows debug settings.",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "win-release",
            "description": "Factored windows release settings.",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "win-msvc-debug-static",
            "displayName": "Windows/MSVC/Debug/Static",
            "description": "Debug build with msvc and static linking.",
            "hidden": false,
            "inherits": [
                "static",
                "win-debug",
                "msvc",
                "win-base"
            ]
        },
        {
            "name": "win-msvc-release-static",
            "displayName": "Windows/MSVC/Release/Static",
            "description": "Release build with msvc and static linking.",
            "hidden": false,
            "inherits": [
                "static",
                "win-release",
                "msvc",
                "win-base"
            ]
        },
        {
            "name": "win-clangcl-debug-static",
            "displayName": "Windows/clang-cl/Debug/Static",
            "description": "Debug build with clang-cl and static linking.",
            "hidden": false,
            "inherits": [
                "static",
                "win-debug",
                "clangcl",
                "win-base"
            ]
        },
        {
            "name": "win-clangcl-release-static",
            "displayName": "Windows/clang-cl/Release/Static",
            "description": "Release build with clang-cl and static linking.",
            "hidden": false,
            "inherits": [
                "static",
                "win-release",
                "clangcl",
                "win-base"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "nix-target-list",
            "hidden": true,
            "targets": [
                "libbitcoin-system",
                "libbitcoin-system-test",
                "bitcoin-selector"
            ]
        },
        {
            "name": "nix-gnu-debug-static",
            "displayName": "*nix/GNU/Debug/Static",
            "inherits": [ "nix-target-list" ],
            "configurePreset": "nix-gnu-debug-static"
        },
        {
            "name": "nix-gnu-debug-shared",
            "displayName": "*nix/GNU/Debug/Shared",
            "inherits": [ "nix-target-list" ],
            "configurePreset": "nix-gnu-debug-shared"
        },
        {
            "name": "nix-gnu-release-static",
            "displayName": "*nix/GNU/Release/Static",
            "inherits": [ "nix-target-list" ],
            "configurePreset": "nix-gnu-release-static"
        },
        {
            "name": "nix-gnu-release-shared",
            "displayName": "*nix/GNU/Release/Shared",
            "inherits": [ "nix-target-list" ],
            "configurePreset": "nix-gnu-release-shared"
        },
        {
            "name": "win-msvc-debug-static",
            "displayName": "Windows/MSVC/Debug/Static",
            "inherits": [ "nix-target-list" ],
            "configurePreset": "win-msvc-debug-static"
        },
        {
            "name": "win-msvc-release-static",
            "displayName": "Windows/MSVC/Release/Static",
            "inherits": [ "nix-target-list" ],
            "configurePreset": "win-msvc-release-static"
        },
        {
            "name": "win-clangcl-debug-static",
            "displayName": "Windows/clang-cl/Debug/Static",
            "inherits": [ "nix-target-list" ],
            "configurePreset": "win-clangcl-debug-static"
        },
        {
            "name": "win-clangcl-release-static",
            "displayName": "Windows/clang-cl/Release/Static",
            "inherits": [ "nix-target-list" ],
            "configurePreset": "win-clangcl-release-static"
        }
    ]
}
