@PACKAGE_INIT@

include( CMakeFindDependencyMacro )

include( "${CMAKE_CURRENT_LIST_DIR}/libbitcoin-system-targets.cmake" )

if ( CMAKE_SYSTEM_NAME MATCHES "BSD" )
  find_dependency( Threads )
endif()

set( with-secp256k1 @with-secp256k1@ )

if ( NOT with-secp256k1 )
  find_dependency( libsecp256k1 0.8.0 REQUIRED )
endif()

check_required_components(@PROJECT_NAME@)
