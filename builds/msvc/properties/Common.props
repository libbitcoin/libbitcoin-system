<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <_PropertySheetDisplayName>Common Settings</_PropertySheetDisplayName>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <ImportGroup Label="PropertySheets">
    <Import Project="$(Platform).props" />
  </ImportGroup>

  <PropertyGroup Label="Configuration">
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
  </PropertyGroup>

  <!-- Option-clang compiles with the Visual Studio clang-cl under the configured toolset. -->
  <PropertyGroup>
    <Option-clang Condition="'$(Option-clang)' == ''">false</Option-clang>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Option-clang)' == 'true'">
    <CLToolExe>clang-cl.exe</CLToolExe>
    <CLToolPath>$(VCInstallDir)Tools\Llvm\x64\bin</CLToolPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>

      <!-- General -->
      <!-- WarningLevel:EnableAllWarnings produce warning flood (mostly from STL/Boost). -->
      <WarningLevel>Level4</WarningLevel>
      <CompileAsManaged>false</CompileAsManaged>
      <CompileAsWinRT>false</CompileAsWinRT>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/bigobj %(AdditionalOptions)</AdditionalOptions>

      <!-- Language -->
      <!-- /Zc is conformance mode. -->
      <AdditionalOptions>/Zc:__cplusplus /Zc:preprocessor %(AdditionalOptions)</AdditionalOptions>
      <EnforceTypeConversionRules>true</EnforceTypeConversionRules>
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
      <OpenMPSupport>false</OpenMPSupport>
      <EnableModules>false</EnableModules>
      <LanguageStandard_C>stdc11</LanguageStandard_C>
      <LanguageStandard Condition="'$(PlatformToolset)' == 'v141'">stdcpp14</LanguageStandard>
      <LanguageStandard Condition="'$(PlatformToolset)' == 'v142'">stdcpp17</LanguageStandard>
      <LanguageStandard Condition="'$(PlatformToolset)' == 'v143'">stdcpp20</LanguageStandard>
      <LanguageStandard Condition="'$(PlatformToolset)' == 'v145'">stdcpp20</LanguageStandard>
      <ConformanceMode Condition="'$(PlatformToolset)' == 'v141'">false</ConformanceMode>
      <ConformanceMode Condition="'$(PlatformToolset)' == 'v142'">true</ConformanceMode>
      <ConformanceMode Condition="'$(PlatformToolset)' == 'v143'">true</ConformanceMode>
      <ConformanceMode Condition="'$(PlatformToolset)' == 'v145'">true</ConformanceMode>

      <!-- External Includes -->
      <!-- ExternalWarningLevel:EnableAllWarnings produce warning flood (mostly from STL/Boost). -->
      <!-- Language extensions are enabled by default (required for STL/Boost). -->
      <ExternalWarningLevel>Level4</ExternalWarningLevel>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- clang-cl applies external warnings to system headers, and ignores some msvc options. -->
  <ItemDefinitionGroup Condition="'$(Option-clang)' == 'true'">
    <ClCompile>
      <AdditionalOptions Condition="'$(Platform)' == 'Win32'">--target=i686-pc-windows-msvc %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Platform)' == 'ARM64'">--target=aarch64-pc-windows-msvc %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions>-Wno-unused-command-line-argument %(AdditionalOptions)</AdditionalOptions>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- clang-cl enables x86 intrinsics by target feature, as gcc/clang, where msvc uses the WITH_ options. -->
  <ItemDefinitionGroup Condition="'$(Option-clang)' == 'true' And ('$(Platform)' == 'x64' Or '$(Platform)' == 'Win32')">
    <ClCompile>
      <AdditionalOptions Condition="'$(Option-sha)' == 'true'">-msse4.1 -msha %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Option-sha512)' == 'true'">-mavx2 -msha512 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Option-avx512ifma)' == 'true'">-mavx512ifma -mavx512vl %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Option-avxifma)' == 'true'">-mavxifma %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Option-aesni)' == 'true'">-msse4.1 -maes -mpclmul %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Option-vaes)' == 'true'">-mavx2 -maes -mpclmul -mvaes -mvpclmulqdq %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>

</Project>