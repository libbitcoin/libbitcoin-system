<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <_PropertySheetDisplayName>libbitcoin-system-test Settings</_PropertySheetDisplayName>
  </PropertyGroup>

  <ItemGroup Label="BuildOptionsExtension">
    <PropertyPageSchema Condition="Exists('$(MSBuildThisFileDirectory)libbitcoin-system-test.xml')" Include="$(MSBuildThisFileDirectory)libbitcoin-system-test.xml" />
  </ItemGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PreprocessorDefinitions Condition="'$(Option-performance-tests)' == 'true'">WITH_PERFORMANCE_TESTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Option-slow-tests)' == 'true'">WITH_SLOW_TESTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <PostBuildEvent Condition="'$(DebugOrRelease)' == 'Release'">
      <Command>"$(TargetPath)" --log_level=warning --run_test=* --show_progress=no --build_info=yes</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>

  <ImportGroup Label="PropertySheets">
    <Import Project="$(SolutionDir)libbitcoin-system.import.props" />
  </ImportGroup>

  <PropertyGroup>
    <Linkage-libbitcoin-system>$(DefaultLinkage)</Linkage-libbitcoin-system>
  </PropertyGroup>

  <PropertyGroup>
    <Option-performance-tests Condition="'$(Option-performance-tests)' == ''">false</Option-performance-tests>
    <Option-slow-tests Condition="'$(Option-slow-tests)' == ''">false</Option-slow-tests>
  </PropertyGroup>

  <Target Name="OptionInfo" BeforeTargets="PrepareForBuild">
    <Message Text="Option-performance-tests : $(Option-performance-tests)" Importance="high"/>
    <Message Text="Option-slow-tests        : $(Option-slow-tests)" Importance="high"/>
  </Target>

  <Target Name="LinkageInfo" BeforeTargets="PrepareForBuild">
    <Message Text="Linkage-libbitcoin-system : $(Linkage-libbitcoin-system)" Importance="high"/>
  </Target>

</Project>
