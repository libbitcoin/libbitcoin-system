 |         GENERATED SOURCE CODE, DO NOT EDIT EXCEPT EXPERIMENTALLY
 |
 -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <_PropertySheetDisplayName>libbitcoin-system Settings</_PropertySheetDisplayName>
  </PropertyGroup>

  <ItemGroup Label="BuildOptionsExtension">
    <PropertyPageSchema Condition="Exists('$(MSBuildThisFileDirectory)libbitcoin-system.xml')" Include="$(MSBuildThisFileDirectory)libbitcoin-system.xml" />
  </ItemGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>$(RepoRoot)build\include\;$(RepoRoot)include\;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions Condition="'$(ConfigurationType)' == 'DynamicLibrary'">BC_DLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(ConfigurationType)' == 'StaticLibrary'">BC_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Option-avx512ifma)' == 'true'">WITH_AVX512IFMA;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Option-avxifma)' == 'true'">WITH_AVXIFMA;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Option-shani)' == 'true'">WITH_SHANI;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Option-sha512)' == 'true'">WITH_SHA512;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Option-aesni)' == 'true'">WITH_AESNI;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Option-vaes)' == 'true'">WITH_VAES;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Option-aes)' == 'true'">WITH_AES;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Option-sha2)' == 'true'">WITH_SHA2;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Option-sha3)' == 'true'">WITH_SHA3;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Option-secp256k1)' == 'true'">WITH_SECP256K1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Option-valgrind)' == 'true'">WITH_VALGRIND;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Option-cuda)' == 'true'">WITH_CUDA;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(PlatformToolset)' == 'ClangCL' And ('$(Platform)' == 'Win32' Or '$(Platform)' == 'x64')">
    <ClCompile>
      <AdditionalOptions Condition="'$(Option-avx2)' == 'true'">-mavx -mavx2 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Option-avx512)' == 'true'">-mavx512f -mavx512bw -mavx512vl %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Option-avx512ifma)' == 'true'">-mavx512ifma -mavx512vl %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Option-avxifma)' == 'true'">-mavxifma %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Option-shani)' == 'true'">-msse4 -msha %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Option-sha512)' == 'true'">-mavx2 -msha512 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Option-sse41)' == 'true'">-msse4.1 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Option-aesni)' == 'true'">-msse4.1 -maes -mpclmul %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Option-vaes)' == 'true'">-mavx2 -maes -mpclmul -mvaes -mvpclmulqdq %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(PlatformToolset)' == 'ClangCL' And ('$(Platform)' == 'ARM64')">
    <ClCompile>
      <ArmBase Condition="'$(Option-aes)' == 'true'">armv8-a</ArmBase>
      <ArmBase Condition="'$(Option-sha2)' == 'true'">armv8-a</ArmBase>
      <ArmBase Condition="'$(Option-sha3)' == 'true'">armv8.2-a</ArmBase>
      <ArmExtensions Condition="'$(Option-aes)' == 'true'">%(ArmExtensions)+aes</ArmExtensions>
      <ArmExtensions Condition="'$(Option-sha2)' == 'true'">%(ArmExtensions)+sha2</ArmExtensions>
      <ArmExtensions Condition="'$(Option-sha3)' == 'true'">%(ArmExtensions)+sha3</ArmExtensions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(PlatformToolset)' == 'ClangCL' And ('$(Platform)' == 'ARM64') And ('$(Option-aes)' == 'true' Or '$(Option-sha2)' == 'true' Or '$(Option-sha3)' == 'true')">
    <ClCompile>
      <AdditionalOptions>-march=%(ArmBase)%(ArmExtensions) %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>

  <PropertyGroup>
    <Option-shani Condition="'$(Option-shani)' == ''">false</Option-shani>
    <Option-sha512 Condition="'$(Option-sha512)' == ''">false</Option-sha512>
    <Option-aesni Condition="'$(Option-aesni)' == ''">false</Option-aesni>
    <Option-vaes Condition="'$(Option-vaes)' == ''">false</Option-vaes>
    <Option-avx512ifma Condition="'$(Option-avx512ifma)' == ''">false</Option-avx512ifma>
    <Option-avx512 Condition="'$(Option-avx512)' == ''">false</Option-avx512>
    <Option-avxifma Condition="'$(Option-avxifma)' == ''">false</Option-avxifma>
    <Option-avx2 Condition="'$(Option-avx2)' == ''">false</Option-avx2>
    <Option-sse41 Condition="'$(Option-sse41)' == ''">false</Option-sse41>
    <Option-sha2 Condition="'$(Option-sha2)' == ''">false</Option-sha2>
    <Option-sha3 Condition="'$(Option-sha3)' == ''">false</Option-sha3>
    <Option-aes Condition="'$(Option-aes)' == ''">false</Option-aes>
    <Option-secp256k1 Condition="'$(Option-secp256k1)' == ''">true</Option-secp256k1>
    <Option-valgrind Condition="'$(Option-valgrind)' == ''">false</Option-valgrind>
    <Option-cuda Condition="'$(Option-cuda)' == ''">true</Option-cuda>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'Win32' Or '$(Platform)' == 'x64'">
    <Option-arch Condition="'$(Option-sse41)' == 'true' And '$(Option-arch)' != 'AdvancedVectorExtensions2' And '$(Option-arch)' != 'AdvancedVectorExtensions512'">AdvancedVectorExtensions</Option-arch>
    <Option-arch Condition="('$(Option-avx2)' == 'true' Or '$(Option-avxifma)' == 'true' Or '$(Option-sha512)' == 'true' Or '$(Option-vaes)' == 'true') And '$(Option-arch)' != 'AdvancedVectorExtensions512'">AdvancedVectorExtensions2</Option-arch>
    <Option-arch Condition="'$(Option-avx512)' == 'true'">AdvancedVectorExtensions512</Option-arch>
  </PropertyGroup>

  <Target Name="OptionInfo" BeforeTargets="PrepareForBuild">
    <Message Text="Option-shani      : $(Option-shani)" Importance="high"/>
    <Message Text="Option-sha512     : $(Option-sha512)" Importance="high"/>
    <Message Text="Option-aesni      : $(Option-aesni)" Importance="high"/>
    <Message Text="Option-vaes       : $(Option-vaes)" Importance="high"/>
    <Message Text="Option-avx512ifma : $(Option-avx512ifma)" Importance="high"/>
    <Message Text="Option-avx512     : $(Option-avx512)" Importance="high"/>
    <Message Text="Option-avxifma    : $(Option-avxifma)" Importance="high"/>
    <Message Text="Option-avx2       : $(Option-avx2)" Importance="high"/>
    <Message Text="Option-sse41      : $(Option-sse41)" Importance="high"/>
    <Message Text="Option-sha2       : $(Option-sha2)" Importance="high"/>
    <Message Text="Option-sha3       : $(Option-sha3)" Importance="high"/>
    <Message Text="Option-aes        : $(Option-aes)" Importance="high"/>
    <Message Text="Option-secp256k1  : $(Option-secp256k1)" Importance="high"/>
    <Message Text="Option-valgrind   : $(Option-valgrind)" Importance="high"/>
    <Message Text="Option-cuda       : $(Option-cuda)" Importance="high"/>
  </Target>

</Project>
