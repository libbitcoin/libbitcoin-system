<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <_PropertySheetDisplayName>Libbitcoin System Library Common Settings</_PropertySheetDisplayName>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
    <RunCodeAnalysis>false</RunCodeAnalysis>
  </PropertyGroup>

  <!-- User Interface -->

  <ItemGroup Label="BuildOptionsExtension">
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)$(ProjectName).xml" />
  </ItemGroup>

  <!-- Configuration -->

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(RepoRoot)include\;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalIncludeDirectories>$(RepoRoot)build\include\;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <EnablePREfast>false</EnablePREfast>
      <!-- NOMINMAX enables use of std::min/max without conflict. -->
      <!-- WIN32_LEAN_AND_MEAN avoids inclusion of certain headers, winsock.h conflicts with boost and protocol use of winsock2.h. -->
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;_WIN32_WINNT=0x0A00;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(ConfigurationType)' == 'DynamicLibrary'">BC_DLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(ConfigurationType)' == 'StaticLibrary'">BC_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="$(Configuration.IndexOf('Debug')) != -1">_CRTDBG_MAP_ALLOC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Enable use of CPU intrinsics. -->
      <!--<PreprocessorDefinitions Condition="'$(Option-512)' == 'true'">WITH_512;%(PreprocessorDefinitions)</PreprocessorDefinitions>-->
      <!--<PreprocessorDefinitions Condition="'$(Option-256)' == 'true'">WITH_256;%(PreprocessorDefinitions)</PreprocessorDefinitions>-->
      <!--<PreprocessorDefinitions Condition="'$(Option-128)' == 'true'">WITH_128;%(PreprocessorDefinitions)</PreprocessorDefinitions>-->
      <PreprocessorDefinitions Condition="'$(Option-sha)' == 'true'">WITH_SHA;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Option-sha512)' == 'true'">WITH_SHA512;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Option-avx512ifma)' == 'true'">WITH_AVX512IFMA;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Option-avxifma)' == 'true'">WITH_AVXIFMA;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Option-aesni)' == 'true'">WITH_AESNI;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Option-vaes)' == 'true'">WITH_VAES;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Option-secp256k1)' == 'true'">WITH_SECP256K1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Dependencies -->

  <PropertyGroup Condition="'$(NuGetPackageRoot)' == ''">
    <NuGetPackageRoot>..\..\..\..\..\.nuget\packages\</NuGetPackageRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DefaultLinkage)' == 'dynamic'">
    <Linkage-secp256k1 Condition="'$(Option-secp256k1)' == 'true'">dynamic</Linkage-secp256k1>
    <Linkage-ultrafast Condition="'$(Option-ultrafast)' == 'true'">dynamic</Linkage-ultrafast>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DefaultLinkage)' == 'ltcg'">
    <Linkage-secp256k1 Condition="'$(Option-secp256k1)' == 'true'">ltcg</Linkage-secp256k1>
    <Linkage-ultrafast Condition="'$(Option-ultrafast)' == 'true'">ltcg</Linkage-ultrafast>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DefaultLinkage)' == 'static'">
    <Linkage-secp256k1 Condition="'$(Option-secp256k1)' == 'true'">static</Linkage-secp256k1>
    <Linkage-ultrafast Condition="'$(Option-ultrafast)' == 'true'">static</Linkage-ultrafast>
  </PropertyGroup>
  
  <!-- Options -->

  <!-- These create non-portability. -->
  <!-- These will compile to the target regardless of the compiling platform. -->
  <!-- That will result in a crash of test/executable execution if mismatched. -->
  <PropertyGroup>
    <!--<Option-512>false</Option-512>-->
    <!--<Option-256>true</Option-256>-->
    <!--<Option-128>true</Option-128>-->
    <Option-sha Condition="'$(Option-sha)' == ''">false</Option-sha>
    <Option-sha512 Condition="'$(Option-sha512)' == ''">false</Option-sha512>
    <Option-avx512ifma Condition="'$(Option-avx512ifma)' == ''">false</Option-avx512ifma>
    <Option-avxifma Condition="'$(Option-avxifma)' == ''">false</Option-avxifma>
    <Option-aesni Condition="'$(Option-aesni)' == ''">false</Option-aesni>
    <Option-vaes Condition="'$(Option-vaes)' == ''">false</Option-vaes>
    <Option-secp256k1 Condition="'$(Option-secp256k1)' == ''">false</Option-secp256k1>
    <Option-ultrafast Condition="'$(Option-ultrafast)' == ''">false</Option-ultrafast>
    <Option-cuda Condition="'$(Option-cuda)' == ''">false</Option-cuda>
  </PropertyGroup>

  <!-- Width options, and options that require a width, raise Option-arch (highest wins). -->
  <PropertyGroup Condition="'$(Platform)' == 'x64' Or '$(Platform)' == 'Win32'">
    <Option-arch Condition="'$(Option-sse41)' == 'true' And ('$(Option-arch)' == '' Or '$(Option-arch)' == 'StreamingSIMDExtensions' Or '$(Option-arch)' == 'StreamingSIMDExtensions2')">AdvancedVectorExtensions</Option-arch>
    <Option-arch Condition="('$(Option-avx2)' == 'true' Or '$(Option-avxifma)' == 'true' Or '$(Option-vaes)' == 'true' Or '$(Option-sha512)' == 'true') And '$(Option-arch)' != 'AdvancedVectorExtensions512'">AdvancedVectorExtensions2</Option-arch>
    <Option-arch Condition="'$(Option-avx512)' == 'true'">AdvancedVectorExtensions512</Option-arch>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- order matters -->
      <!-- Native configuration now specifyies avx, avx2 or avx512 - in which case we run 128, 256, 512. -->
      <!--<EnableEnhancedInstructionSet Condition="'$(Option-128)' == 'true'">AdvancedVectorExtensions</EnableEnhancedInstructionSet>-->
      <!--<EnableEnhancedInstructionSet Condition="'$(Option-256)' == 'true'">AdvancedVectorExtensions2</EnableEnhancedInstructionSet>-->
      <!--<EnableEnhancedInstructionSet Condition="'$(Option-512)' == 'true'">AdvancedVectorExtensions512</EnableEnhancedInstructionSet>-->
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Messages -->

  <Target Name="OptionInfo" BeforeTargets="PrepareForBuild">
    <Message Text="Option-sha        : $(Option-sha)" Importance="high"/>
    <Message Text="Option-sha512     : $(Option-sha512)" Importance="high"/>
    <Message Text="Option-avx512ifma : $(Option-avx512ifma)" Importance="high"/>
    <Message Text="Option-avxifma    : $(Option-avxifma)" Importance="high"/>
    <Message Text="Option-aesni      : $(Option-aesni)" Importance="high"/>
    <Message Text="Option-vaes       : $(Option-vaes)" Importance="high"/>
    <Message Text="Option-secp256k1  : $(Option-secp256k1)" Importance="high"/>
    <Message Text="Option-ultrafast  : $(Option-ultrafast)" Importance="high"/>
    <Message Text="Option-cuda       : $(Option-cuda)" Importance="high"/>
    <!--<Message Text="Option-512        : $(Option-512)" Importance="high"/>-->
    <!--<Message Text="Option-256        : $(Option-256)" Importance="high"/>-->
    <!--<Message Text="Option-128        : $(Option-128)" Importance="high"/>-->
  </Target>

  <!-- Linkage -->

  <Target Name="LinkageInfo" BeforeTargets="PrepareForBuild">
    <Message Text="Linkage-secp256k1 : $(Linkage-secp256k1)" Importance="high"/>
    <Message Text="Linkage-ultrafast : $(Linkage-ultrafast)" Importance="high"/>
  </Target>

</Project>
