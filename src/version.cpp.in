#include <bitcoin/system/version.hpp>

namespace libbitcoin {
namespace system {

const build_version_t& build_version() noexcept
{
    static constexpr build_version_t value
    {
        "@LIBBITCOIN_VERSION_MAJOR@.@LIBBITCOIN_VERSION_MINOR@.@LIBBITCOIN_VERSION_PATCH@",
        "@GIT_COMMIT_HASH@",
        @GIT_DIRTY@ != 0
    };

    return value;
}

} // namespace system
} // namespace libbitcoin
